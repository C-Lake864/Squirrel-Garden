# 견본 파일 (실제 값 없음, 커밋해도 안전). 필요하면 복사해서 .env 로 쓰세요.
# 이 앱은 .env 없이도 아래 기본값으로 그냥 실행됩니다.
PORT=3000
DATABASE_FILE=./todo.db

# ---- 컨테이너 밖 데이터베이스(Supabase) 쓰기: 기본값은 아래처럼 꺼져 있다 ----
# 켜려면 STORAGE 와 AUTH 를 둘 다 supabase 로 바꾸고 아래 세 값을 편집기로 직접 채운다.
# (로그인 없이 STORAGE=supabase 만 켜면 앱이 시작하지 않는다.) 키 값은 채팅이나 코드에 붙여 넣지 않는다.
# SUPABASE_SECRET_KEY 는 서버에서만 쓰는 값이라 화면으로 보내지 않는다. .env 는 커밋하지 않는다.
STORAGE=sqlite
AUTH=none
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
